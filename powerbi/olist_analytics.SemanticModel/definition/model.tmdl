model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-PE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["gold dim_customers","gold dim_products","gold dim_sellers","gold fct_orders","gold fct_order_items","dim_date","_Measures","sup_rank"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table 'gold dim_customers'
ref table 'gold dim_products'
ref table 'gold dim_sellers'
ref table 'gold fct_orders'
ref table 'gold fct_order_items'
ref table dim_date
ref table _Measures
ref table sup_rank

ref cultureInfo en-US

